{
  "mcpServers": {
    "aws_docs": {
      "args": [
        "awslabs.aws-documentation-mcp-server@1.2.1"
      ],
      "command": "uvx",
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "WARNING"
      },
      "inherit": [
        "PATH",
        "HOME",
        "TMPDIR",
        "AWS_PROFILE",
        "AWS_DEFAULT_PROFILE",
        "AWS_CONFIG_FILE",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_SDK_LOAD_CONFIG"
      ]
    },
    "context7": {
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "args": []
    },
    "homebrew": {
      "args": [
        "mcp-server"
      ],
      "command": "brew"
    },
    "atlassian": {
      "args": [
        "mcp-atlassian@0.23.1"
      ],
      "command": "uvx",
      "env": {
        "JIRA_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "JIRA_URL": "${ATLASSIAN_URL}",
        "JIRA_USERNAME": "${ATLASSIAN_USERNAME}",
        "CONFLUENCE_API_TOKEN": "${ATLASSIAN_API_TOKEN}",
        "CONFLUENCE_URL": "${ATLASSIAN_URL}/wiki",
        "CONFLUENCE_USERNAME": "${ATLASSIAN_USERNAME}"
      }
    },
    "browser_tools": {
      "args": [
        "-y",
        "@agentdeskai/browser-tools-mcp@2.0.2"
      ],
      "command": "npx"
    },
    "cloudwatch": {
      "args": [
        "awslabs.cloudwatch-mcp-server@0.2.1"
      ],
      "command": "uvx",
      "env": {
        "AWS_REGION": "${AWS_REGION}",
        "FASTMCP_LOG_LEVEL": "WARNING"
      },
      "inherit": [
        "PATH",
        "HOME",
        "TMPDIR",
        "AWS_PROFILE",
        "AWS_DEFAULT_PROFILE",
        "AWS_CONFIG_FILE",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_SDK_LOAD_CONFIG"
      ]
    },
    "dynamodb": {
      "args": [
        "awslabs.dynamodb-mcp-server@2.1.1"
      ],
      "command": "uvx",
      "env": {
        "AWS_REGION": "${AWS_REGION}",
        "FASTMCP_LOG_LEVEL": "WARNING"
      },
      "inherit": [
        "PATH",
        "HOME",
        "TMPDIR",
        "AWS_PROFILE",
        "AWS_DEFAULT_PROFILE",
        "AWS_CONFIG_FILE",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_SDK_LOAD_CONFIG"
      ]
    },
    "fetch": {
      "args": [
        "mcp-server-fetch@2026.8.18"
      ],
      "command": "uvx"
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "${HOME}/Documents"
      ],
      "command": "npx",
      "env": {},
      "enabled": false
    },
    "github": {
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "args": []
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@1.0.0"
      ],
      "command": "npx"
    },
    "puppeteer": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer@2025.5.12"
      ],
      "command": "npx"
    },
    "sequential_thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@1.0.0"
      ],
      "command": "npx"
    },
    "time": {
      "args": [
        "mcp-server-time@2026.8.18"
      ],
      "command": "uvx"
    }
  }
}
